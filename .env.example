# ==============================================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para ".env" na raiz do projeto e preencha com seus dados:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações do Servidor Web (utilizado em src/index.ts)
# ------------------------------------------------------------------------------
# Porta TCP em que o servidor Express escutará as requisições HTTP.
# Padrão: 3978 (porta convencional do Bot Framework).
PORT=3978


# ------------------------------------------------------------------------------
# 2. Configurações do Microsoft Bot Framework (utilizado em src/index.ts)
# ------------------------------------------------------------------------------
# IMPORTANTE PARA TESTES LOCAIS:
# Para rodar e testar o bot localmente usando o "Bot Framework Emulator",
# mantenha os quatro campos abaixo TOTALMENTE VAZIOS.
#
# Em ambiente de produção (Azure Bot Service / Cloud), preencha com as credenciais
# do registro do seu bot geradas no Portal do Azure ou Entra ID.
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=
MicrosoftAppTenantId=


# ------------------------------------------------------------------------------
# 3. Configurações do Azure AI Foundry / Modelos Phi-4 (utilizado em src/bot.ts)
# ------------------------------------------------------------------------------
# Endpoint REST do seu recurso ou deployment no Azure AI Foundry.
# ATENÇÃO AO FORMATO: Como o bot utiliza a biblioteca cliente da OpenAI, o endpoint
# DEVE terminar obrigatoriamente com o caminho "/openai/v1".
# Exemplo: https://seu-recurso.services.ai.azure.com/openai/v1
AZURE_PHI_ENDPOINT=https://<seu-recurso>.services.ai.azure.com/openai/v1

# Chave de autenticação (API Key) do seu recurso ou deployment no Azure AI Foundry.
# Obtida na seção de chaves e endpoints do portal do Azure AI Foundry.
AZURE_PHI_API_KEY=sua_chave_de_api_aqui

# Nome do modelo implantado (deployment name) no Azure AI Foundry.
# Se deixado em branco ou não definido, o código assumirá 'Phi-4-reasoning' por padrão.
# Exemplos comuns:
#   - Phi-4-reasoning    (modelo com raciocínio profundo / chain-of-thought)
#   - Phi-4-mini-instruct (versão leve e rápida para instruções diretas)
AZURE_PHI_MODEL=Phi-4-reasoning
